# ═══════════════════════════════════════════════════════════════
# VotExpress Midnight — Variables de Entorno
# ═══════════════════════════════════════════════════════════════

# Red Midnight: "testnet" | "mainnet" | "local"
# Cambiar a "mainnet" para producción real
NEXT_PUBLIC_MIDNIGHT_NETWORK=testnet

# ── Blockfrost (requerido para testnet y mainnet) ──────────────
# Crear cuenta gratuita en https://blockfrost.io
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=

# ── Direcciones de Contratos Desplegados ───────────────────────
# Se llenan automáticamente al ejecutar: npx ts-node scripts/deploy-contracts.ts
NEXT_PUBLIC_VOTING_CONTRACT_ADDRESS=
NEXT_PUBLIC_DNI_CONTRACT_ADDRESS=

# ── Proof Server (siempre local vía Docker) ────────────────────
NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300

# ── Admin Wallet (seed phrase para gas relay — SOLO SERVER SIDE) ─
# ⚠️  NUNCA exponer en el frontend (sin prefijo NEXT_PUBLIC_)
MIDNIGHT_ADMIN_SEED_PHRASE=

# ── Duración de Votación por defecto (segundos) ───────────────
# 86400 = 24 horas
NEXT_PUBLIC_VOTING_DURATION_SECONDS=86400
